target/
.DS_Store
*.xcuserstate
bin/
obj/

# Local vaults that might be created while trying things out. The test fixture under
# crates/kagisecure-core/tests/vectors/ is deliberately committed and is excluded below.
*.kagivault
*.kagivault.bak-*
*.attachments/
!crates/kagisecure-core/tests/vectors/*.kagivault

# macOS app build artifacts.
#
# The Xcode project is generated from apps/macos/project.yml by `xcodegen generate`, so it is a
# build artifact like any other (ADR-0010). The xcframework and its staged headers are produced
# by `cargo xtask bindgen`; the *generated Swift* it also produces is deliberately committed
# (ADR-0009) and is not listed here.
apps/macos/Kagisecure.xcodeproj/
# Info.plist and the default entitlements are also generated, from the `info:`/`entitlements:`
# blocks in project.yml. Signing/Provisioned.entitlements is hand-written and IS committed.
apps/macos/Kagisecure/Info.plist
apps/macos/Kagisecure/Kagisecure.entitlements
apps/macos/KagisecureTests/Info.plist
apps/macos/KagisecureUITests/Info.plist
apps/macos/KagisecureUITests/KagisecureUITests.entitlements
apps/macos/KagisecureSafariExtension/Info.plist
apps/macos/KagisecureSafariExtension/KagisecureSafariExtension.entitlements
apps/macos/KagisecureFFI/Artifacts/
apps/macos/KagisecureFFI/.build/
# The app icon is generated by apps/macos/Scripts/make-icon.sh from the committed artwork in
# apps/macos/Artwork/, so the artwork is the source of truth and the .icns is not in review
# (ADR-0028). A local icon-1024.png here overrides the artwork for experiments. `make macos` and
# `cargo xtask dist` both regenerate it when it is missing.
apps/macos/Kagisecure/Resources/*.icns
apps/macos/Kagisecure/Resources/icon-1024.png
apps/macos/Signing/Local.xcconfig
DerivedData/
build/
# Xcode result bundles. `e2e/suites/app/run-xcuitest.mjs` writes one per run into the harness's
# scratch directory, and `xcodebuild` drops one in /var/folders on a failure it cannot attribute;
# neither belongs in a history, and a stray one in the checkout is a gigabyte of screenshots.
*.xcresult
*.xcworkspace/xcuserdata/
apps/macos/KagisecureFFI/.swiftpm/

# Browser extension: npm and Playwright artifacts. The extension's own source is in
# extensions/shared and is committed; extensions/chrome holds only the Node test package, and has
# its own .gitignore too.
extensions/chrome/node_modules/
extensions/chrome/package-lock.json
extensions/chrome/test-results/
extensions/chrome/playwright-report/

# Release artifacts: the signed app, the DMG, the notarization staging zip. `cargo xtask dist`
# writes all of it here, and none of it belongs in a git history.
dist/

# The end-to-end harness (e2e/, docs/e2e-harness.md). The runner writes a self-contained HTML
# report and a merged junit.xml into e2e/report/, and stages screenshots and logs in e2e/tmp/
# until they are embedded in that report. Both are regenerated by `make e2e` every run.
e2e/report/
e2e/tmp/

# npm, anywhere. `extensions/chrome/node_modules/` above is the one that actually exists today;
# this catches a package the e2e harness or a future sub-project installs into its own directory.
node_modules/
