<?xml version="1.0" encoding="utf-8"?>
<!--
  Kagisecure's Windows MSI — ADR-0034: a per-user install, no admin/UAC, everything flat in one
  directory. "Flat" is load-bearing, not cosmetic: kagisecure_agent::bundle::find's "beside the
  running executable" search already finds a helper next to whatever binary asked for it, so this
  layout is what lets the app, the CLI and both sidecars find each other with zero changes to
  crates/. Do not add a subdirectory under INSTALLFOLDER for any of the files below.

  Built by `cargo xtask dist-windows` (xtask/src/dist_windows.rs), never by hand:

    dotnet tool restore
    dotnet tool run wix [dash dash] extension add WixToolset.UI.wixext/5.0.1
    dotnet tool run wix [dash dash] extension add WixToolset.Util.wixext/5.0.1
    dotnet tool run wix [dash dash] build Product.wxs -arch x64 -ext WixToolset.UI.wixext \
      -ext WixToolset.Util.wixext -d Version=<x.y.z> -d LayoutDir=<path> -o Kagisecure.msi

  LayoutDir is the directory xtask assembled and (usually) already Authenticode-signed every PE
  in: the dotnet-published WinUI app plus the three Rust helpers plus kagisecure_ffi.dll. Every
  file in it is harvested by the Files/@Include glob below — nothing here names them individually,
  so a new file the publish or the helper build produces is picked up automatically.

  The installer wizard (welcome, license, install-folder, progress, finish) comes from the WiX UI
  extension's stock WixUI_InstallDir dialog set, referenced below by UIRef. The "Launch Kagisecure"
  finish-page checkbox is the Util extension's WixShellExec custom action, wired to the same
  ExitDialog. Neither extension is fetched globally: xtask restores both into a project-local
  `.wix/extensions` cache under this directory (gitignored), the same reproducible-NuGet-restore
  posture as the `wix` tool itself (`dotnet-tools.json`). Quiet installs
  (`msiexec /i ... /quiet`) run the ExecuteSequence only, never the UI sequence these dialogs live
  in — the wizard and the Launch checkbox's DoAction event never enter into a silent install at
  all, so /quiet behaves exactly as it did before this file added a UI.

  License.rtf is generated by `license_rtf.rs` from LICENSE-MIT + LICENSE-APACHE at the repository
  root, every `dist-windows` run — not checked in, so it can never go stale relative to the actual
  license text. `wix build` fails here if it is missing, which is the point: nobody can ship an
  installer whose license dialog silently shows an old license.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Kagisecure"
           Manufacturer="Kagisecure"
           Version="$(var.Version)"
           UpgradeCode="7C4AD0F7-AB02-4B99-81A0-EE45D551ED28"
           Scope="perUser"
           Language="1033"
           Compressed="yes">

    <SummaryInformation Description="Kagisecure — a local-first password manager" Manufacturer="Kagisecure" />

    <!-- The app icon, read from the exe it is embedded in (ApplicationIcon in the csproj), for
         the Start menu shortcut and Add/Remove Programs. -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.LayoutDir)\Kagisecure.App.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!--
      Same UpgradeCode across every version, so an install of a newer MSI replaces the older one
      in place rather than sitting beside it. RemoveExistingProducts is scheduled by MajorUpgrade
      at its default point (after InstallInitialize / InstallValidate, before the new files are
      installed), which — combined with everything living at the same INSTALLFOLDER path across
      versions (below) — is what keeps the native-messaging manifest's absolute path
      (crates/kagisecure-agent/src/browser_setup.rs) valid across an upgrade. See ADR-0034 for why
      that stability is the whole reason MSIX was not chosen.
    -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Kagisecure is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      %LOCALAPPDATA%\Programs\Kagisecure — the same directory name across every version, and the
      same one ADR-0034 requires for the reasons above. Per-user (Scope="perUser" on Package,
      above) needs no admin prompt, matching the rest of the Windows port's no-elevation posture
      (the named-pipe DACL and vault/.env/import ACLs are all single-user).
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Kagisecure" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Kagisecure" />
    </StandardDirectory>

    <!--
      Every file xtask staged into LayoutDir, recursively (the self-contained WinUI publish output
      has a few subdirectories of its own, e.g. resource-language folders; Files preserves
      whatever structure it finds under INSTALLFOLDER). This is a WiX v5 compiler feature — no
      heat.exe harvesting step, no per-file <File> entries to keep in sync by hand.
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.LayoutDir)\**" />
    </ComponentGroup>

    <!--
      A per-user component needs its own HKCU keypath (the classic MSI rule for anything installed
      outside a system-managed directory); the Start Menu shortcut component doubles as the place
      to record "this user installed Kagisecure" for that purpose, and RemoveFolder/uninstall
      cleans up the Start Menu entry. This registry value is not read by anything at runtime —
      unlike browser_setup.rs's HKCU\...\NativeMessagingHosts keys, which the app itself writes
      and clears when a browser integration is turned on or off, and which this installer
      deliberately does not touch: registration is a first-run/setup-screen action, not an install
      action (ADR-0034).
    -->
    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="7B6A6C1E-9C3D-4E9A-8E9C-2A6E1B9C5D41">
      <Shortcut Id="AppStartMenuShortcut"
                Name="Kagisecure"
                Description="A local-first password manager"
                Target="[INSTALLFOLDER]Kagisecure.App.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Kagisecure" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Kagisecure" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!--
      Installer UI: welcome -> license -> install-folder -> progress -> finish, WixUI_InstallDir's
      stock dialog set (WixToolset.UI.wixext). This dialog set is a "protected" extension symbol —
      a plain core-schema <UIRef Id="WixUI_InstallDir"/> fails to link with WIX0094 ("identifier
      'WixUI:WixUI_InstallDir' is inaccessible due to its protection level"), so the extension's own
      <ui:WixUI> element (from the xmlns:ui namespace above) is what actually references it; that
      element's InstallDirectory attribute is also what sets WIXUI_INSTALLDIR under the hood, so no
      separate <Property> for it is needed here. INSTALLFOLDER is the same per-user
      %LOCALAPPDATA%\Programs\Kagisecure directory everything else in this file already targets;
      changing it does not change the *scope* (still perUser, still no elevation), only where under
      the user's own profile the flat layout lands.
    -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- The license dialog's text — see the file-level comment for how License.rtf is produced. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!--
      "Launch Kagisecure" on the finish page: WixUI_InstallDir's ExitDialog already has an
      optional checkbox control, shown whenever WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT is non-empty
      (WixToolset.UI.wixext's ExitDialog.wxs); WIXUI_EXITDIALOGOPTIONALCHECKBOX is its checked
      state, defaulted here to checked. Clicking Finish while it is checked fires LaunchApplication,
      the Util extension's WixShellExec custom action (BinaryRef="Wix4UtilCA_X64" — the x64 Binary
      table entry the Util wixlib ships, matching -arch x64 above), which ShellExecs whatever
      WixShellExecTarget names: the just-installed Kagisecure.App.exe, addressed by the resolved
      INSTALLFOLDER directory property rather than a harvested File Id, since the Files/@Include
      glob above generates its own File Ids and never names this one by hand. `wix build` warns
      WIX1077 on this line ("contains '[INSTALLFOLDER]' ... illegal reference to another property
      ... if this is a string literal, please ignore") — it is not a literal, it *is* meant as a
      property reference, and WixShellExec resolves it correctly at the point it actually runs
      (MsiFormatRecord on the property's stored text), which is after INSTALLFOLDER is resolved.
      Expected, non-fatal, and the pattern WiX's own "run the app after setup" documentation uses.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Kagisecure" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]Kagisecure.App.exe" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

  </Package>
</Wix>
