    "Face ID is not available: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID を使用できません: %@"
          }
        }
      }
    },
    "Face ID no longer unlocks this vault because the enrolled faces changed. Unlock with your master password, then turn Face ID back on in Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録された顔が変更されたため、Face ID ではこの保管庫のロックを解除できなくなりました。マスターパスワードでロックを解除してから、設定で Face ID をもう一度オンにしてください。"
          }
        }
      }
    },
    "Face ID or a passcode is needed to show or copy secrets.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密の情報を表示・コピーするには Face ID またはパスコードが必要です。"
          }
        }
      }
    },
    "Face ID was cancelled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
