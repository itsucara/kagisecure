      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫を作成"
          }
        }
      }
    },
    "Create the vault on this iPhone. It stays on this device and opens with your master password or Face ID.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone に保管庫を作成します。保管庫はこのデバイスにだけ置かれ、マスターパスワードまたは Face ID で開きます。"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
