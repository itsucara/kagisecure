    "It is removed from every member's copy of the shared vault. There is no shared Trash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有保管庫のすべてのメンバーのコピーから削除されます。共有保管庫にゴミ箱はありません。"
          }
        }
      }
    },
