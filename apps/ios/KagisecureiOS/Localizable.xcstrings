    "Kagisecure is locked": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kagisecure はロックされています"
          }
        }
      }
    },
    "Kagisecure keeps the personal vault on this iPhone only. It has no server and makes no network requests: the Mac link goes through a folder you choose in iCloud Drive.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kagisecure は個人の保管庫をこの iPhone にだけ保存します。サーバーはなく、ネットワーク通信も行いません。Mac とのリンクは、iCloud Drive で選んだフォルダを通して行われます。"
          }
        }
      }
    },
    "Label": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベル"
          }
        }
      }
    },
