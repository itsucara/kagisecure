    "The Mac shows six words with the invitation. Type them here; they are never saved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac は招待と一緒に 6 つの単語を表示します。ここに入力してください。単語は保存されません。"
          }
        }
      }
    },
    "The Mac's members pane lists the same digits for this iPhone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のメンバー欄に、この iPhone の同じ数字が表示されます。"
          }
        }
      }
    },
    "The keychain refused the operation: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンが操作を拒否しました: %@"
          }
        }
      }
    },
    "The note will be removed when you save.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存するとメモが削除されます。"
          }
        }
      }
    },
    "The one-time password setup is neither a usable otpauth:// URI nor a Base32 secret.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタイムパスワードの設定が、使用できる otpauth:// URI でも Base32 のシークレットでもありません。"
          }
        }
      }
    },
    "The six words": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6つの単語"
          }
        }
      }
    },
    "The two passwords do not match.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのパスワードが一致しません。"
          }
        }
      }
    },
    "The vault is locked.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫はロックされています。"
          }
        }
      }
    },
    "The vault key is protected by this iPhone's Secure Enclave and Face ID.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫の鍵は、この iPhone の Secure Enclave と Face ID で保護されます。"
          }
        }
      }
    },
    "This cannot be undone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        }
      }
    },
    "This folder could not be remembered: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダを記憶できませんでした: %@"
          }
        }
      }
    },
    "This iPhone has no Face ID key for kagisecure yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone にはまだ kagisecure 用の Face ID 鍵がありません。"
