<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the AutoFill credential provider extension in the default (ad-hoc) build
  (ADR-0045). Hand-written rather than generated from project.yml, because XcodeGen's
  `entitlements:` block pins CODE_SIGN_ENTITLEMENTS and the target needs it to come from the
  overridable KAGI_CP_ENTITLEMENTS instead. A Developer ID build uses
  CredentialProvider.Provisioned.entitlements, which adds the restricted AutoFill entitlement.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.kagisecure</string>
	</array>
</dict>
</plist>
