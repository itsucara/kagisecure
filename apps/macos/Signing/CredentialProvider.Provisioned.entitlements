<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the AutoFill credential provider extension in a build with a team and a
  provisioning profile (ADR-0045).

  The default build (KagisecureCredentialProvider/KagisecureCredentialProvider.entitlements,
  generated by XcodeGen) leaves out the AutoFill entitlement: it is restricted, so a clean ad-hoc
  checkout could not build with it. Without it the extension still builds and embeds, but macOS
  does not offer it under System Settings › General › AutoFill & Passwords.

  To ship it: register com.kagisecure.app.credential-provider in the Apple Developer portal with
  the "AutoFill Credential Provider" capability and the App Group, create a Developer ID
  provisioning profile for it, and build that target with:

      CODE_SIGN_ENTITLEMENTS=Signing/CredentialProvider.Provisioned.entitlements
      PROVISIONING_PROFILE_SPECIFIER=<that profile>
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.kagisecure</string>
	</array>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
</dict>
</plist>
