<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for a build signed with a real team identity and a provisioning profile.

  The default build (Kagisecure/Kagisecure.entitlements, generated by XcodeGen) deliberately does
  NOT carry `keychain-access-groups`: that entitlement is restricted, so its mere presence makes
  Xcode demand a provisioning profile, and a clean checkout could then not build at
  all (nor could CI, before it was removed on 2026-09-19). Without it, though, the Secure Enclave key cannot be filed in the keychain: both
  `SecKeyCreateRandomKey(kSecAttrIsPermanent: true)` and an explicit `SecItemAdd` come back
  `errSecMissingEntitlement` (-34018), on macOS 26.1 / Xcode 26.2. See ADR-0011.

  Use it when you have a team and a registered device:

      xcodebuild -project Kagisecure.xcodeproj -scheme Kagisecure \
          CODE_SIGN_STYLE=Automatic CODE_SIGN_IDENTITY="Apple Development" \
          DEVELOPMENT_TEAM=XXXXXXXXXX \
          CODE_SIGN_ENTITLEMENTS=Signing/Provisioned.entitlements \
          -allowProvisioningUpdates build
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.kagisecure.app</string>
	</array>
</dict>
</plist>
