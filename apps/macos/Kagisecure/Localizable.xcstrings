{
  "sourceLanguage": "en",
  "strings": {
    "This shared vault is not open on this Mac, so nothing was saved. Select it again or rebuild it from its folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この共有保管庫はこの Mac で開かれていないため、保存されませんでした。もう一度選択するか、フォルダから再構築してください。"
          }
        }
      }
    },
    "Turn on Touch ID unlock?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID でのロック解除をオンにしますか？"
          }
        }
      }
    },
    "Unlock kagisecure with your fingerprint instead of typing your master password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスターパスワードを入力する代わりに、指紋で kagisecure のロックを解除できます。"
          }
        }
      }
    },
    "Don't show this again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後表示しない"
          }
        }
      }
    },
    "Not Now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で"
          }
        }
      }
    },
    "Turn On": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにする"
          }
        }
      }
    },
    "%.1f hours": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f 時間"
          }
        }
      }
    },
    "%@ (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (a login: never copied)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（ログイン情報: コピーされません）"
          }
        }
      }
    },
    "%@ (guessed)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(推定)"
          }
        }
      }
    },
    "%@ Try again in %lld second.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld 秒後にもう一度お試しください。"
          }
        }
      }
    },
    "%@ Try again in %lld seconds.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld 秒後にもう一度お試しください。"
          }
        }
      }
    },
    "%@ asked to fill “%@” on %@, which is not a site saved for it. Nothing was filled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %3$@ で「%2$@」の入力を求めましたが、この項目に保存されたサイトではありません。何も入力されていません。"
          }
        }
      }
    },
    "%@ asked twice for a site not saved for the login and is blocked from asking for fills until you unblock it in Agent access.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がログインに保存されていないサイトを 2 回要求したため、「エージェントアクセス」でブロックを解除するまで入力を求められなくなりました。"
          }
        }
      }
    },
    "%@ copied. %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をコピーしました。%2$@"
          }
        }
      }
    },
    "%@ did not run at its time (%@).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は予定の時刻に実行されませんでした（%2$@）。"
          }
        }
      }
    },
    "%@ did not start (%@).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は開始されませんでした（%2$@）。"
          }
        }
      }
    },
    "%@ environments, %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の環境、%2$lld"
          }
        }
      }
    },
    "%@ filled a password from “%@” on %@ and the page made it visible within seconds; kagisecure cleared the field. The agent may have read it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %3$@ で「%2$@」のパスワードを入力したところ、ページが数秒以内にそれを表示しました。kagisecure はフィールドを消去しました。エージェントが読み取った可能性があります。"
          }
        }
      }
    },
    "%@ has asked to fill logins %lld times in %lld minutes; further requests are refused for %lld minutes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %3$lld 分間に %2$lld 回ログインの入力を求めました。今後 %4$lld 分間はリクエストを拒否します。"
          }
        }
      }
    },
    "%@ hidden": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を隠しました"
          }
        }
      }
    },
    "%@ hidden after five minutes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5分経過したため%@を隠しました"
          }
        }
      }
    },
    "%@ holds “%@” (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が「%2$@」（%3$@）を保持しています"
          }
        }
      }
    },
    "%@ holds “%@” (%@) — removed from the vault: rotate these values at their service first": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が「%2$@」（%3$@）を保持しています — 保管庫から削除済みです。まずサービス側でこれらの値をローテーションしてください"
          }
        }
      }
    },
    "%@ is a complete, unencrypted copy of everything you just imported. %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は読み込んだすべての内容の暗号化されていない完全なコピーです。%2$@"
          }
        }
      }
    },
    "%@ is blocked from asking for fills for 30 minutes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は 30 分間入力を求められなくなりました。"
          }
        }
      }
    },
    "%@ members, %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のメンバー、%2$lld"
          }
        }
      }
    },
    "%@ shown": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を表示しました"
          }
        }
      }
    },
    "%@ wants the one-time code for “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が「%2$@」のワンタイムコードを求めています"
          }
        }
      }
    },
    "%@ wants the password for “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が「%2$@」のパスワードを求めています"
          }
        }
      }
    },
    "%@ wants to add variables to %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$@ に変数を追加しようとしています"
          }
        }
      }
    },
    "%@ wants to create the environment %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が環境 %2$@ を作成しようとしています"
          }
        }
      }
    },
    "%@ wants to run %@ with environment variables": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が環境変数を使って %2$@ を実行しようとしています"
          }
        }
      }
    },
    "%@ wants to write %lld variable to a .env file": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$lld 個の変数を .env ファイルに書き込もうとしています"
          }
        }
      }
    },
    "%@ wants to write %lld variables to a .env file": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$lld 個の変数を .env ファイルに書き込もうとしています"
          }
        }
      }
    },
    "%@ was stopped: %@. Review it in Kagisecure.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が停止されました: %2$@。Kagisecure で確認してください。"
          }
        }
      }
    },
