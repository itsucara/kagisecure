            "value": "、無人ジョブのイベント %lld 件"
          }
        }
      }
    },
    ", %u agent-fill notice(s)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、エージェント入力の通知 %u 件"
          }
        }
      }
    },
    ", %u approval(s) waiting": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、承認待ち %u 件"
          }
        }
      }
    },
    ", unattended jobs armed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、無人ジョブが有効"
          }
        }
      }
    },
    ".env file": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".env ファイル"
          }
        }
      }
    },
    "1 audit entry is not saved to disk yet — the last save failed: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監査ログのエントリ 1 件がまだディスクに保存されていません — 前回の保存に失敗しました: %@"
          }
        }
      }
    },
    "1 audit entry is not saved to disk yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監査ログのエントリ 1 件がまだディスクに保存されていません。"
          }
        }
      }
    },
    "1 computer": {
      "localizations": {
