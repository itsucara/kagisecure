        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィールドを追加"
          }
        }
      }
    },
    "Add to Favorites": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加"
          }
        }
      }
    },
    "Add to favorites": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住所"
          }
        }
      }
    },
    "Admin": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者"
          }
        }
      }
    },
    "After unlocking this way you will be asked to set a new master password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この方法でロック解除すると、新しいマスターパスワードの設定を求められます。"
          }
        }
      }
    },
    "Agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント"
          }
        }
      }
    },
    "Agent access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのアクセス"
          }
        }
      }
    },
    "Agent blocked from fills": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの入力をブロック"
          }
        }
      }
    },
    "Agent fill refused: not a saved site": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントによる入力を拒否: 保存済みのサイトではありません"
          }
        }
      }
    },
    "Agent fills": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントによる入力"
          }
        }
      }
    },
    "Agent fills paused": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントによる入力を一時停止"
          }
        }
      }
    },
    "Agents": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント"
          }
        }
      }
    },
    "Agents (mcp)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント (mcp)"
          }
        }
      }
    },
    "Agents can see this environment's name and its variable names. Never a value.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはこの環境の名前と変数名を見ることができます。値は決して見えません。"
          }
        }
      }
    },
    "Agents can see this item's title, category, tags and field *names* — never values — over MCP, and can request approved actions (like writing a .env) using it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは MCP 経由でこの項目のタイトル、カテゴリ、タグ、フィールドの*名前*を参照できます(値は参照できません)。また、この項目を使った承認済みの操作(.env の書き出しなど)を要求できます。"
          }
        }
      }
    },
    "Agents cannot reach this app": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはこのアプリに接続できません"
          }
        }
      }
    },
    "Agents cannot see anything in a vault that is not shared": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されていない保管庫の内容はエージェントから一切見えません"
          }
        }
      }
    },
    "Agents see titles, categories, tags and field names. Values still need your approval.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに見えるのはタイトル、カテゴリ、タグ、フィールド名だけです。値を使うには引き続きあなたの承認が必要です。"
          }
        }
      }
    },
    "Algorithm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルゴリズム"
          }
        }
      }
    },
    "All Items": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての項目"
          }
        }
      }
    },
    "All results": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての結果"
          }
        }
      }
    },
    "All tools": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのツール"
          }
        }
      }
    },
    "Allow for this session": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッション中は許可"
          }
        }
      }
    },
    "Approval needed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認が必要です"
          }
        }
      }
    },
    "Allow once": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回だけ許可"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可"
          }
        }
      }
    },
    "Also adds, edits and deletes items.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の追加、編集、削除もできます。"
          }
        }
      }
    },
    "Also fill one-time codes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタイムコードも入力"
          }
        }
      }
    },
    "Also invites and removes people and changes roles.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーの招待と削除、役割の変更もできます。"
          }
        }
      }
    },
    "An admin does not allow unattended copies": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者が無人実行用コピーを許可していません"
          }
        }
      }
    },
    "An agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント"
          }
        }
      }
    },
    "An agent asks to fill the one-time code for “%@” on %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが %2$@ で「%1$@」のワンタイムコードの入力を求めています"
          }
        }
      }
    },
    "An agent asks to sign in to ": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがサインインを求めています: "
          }
        }
      }
    },
    "An agent asks to sign in to %@ with “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが「%2$@」を使って %1$@ へのサインインを求めています"
          }
        }
      }
    },
    "An agent can ask kagisecure to type a saved login into the browser tab in front, and each fill waits for you to approve it with Touch ID or your login password. kagisecure never gives the agent a value — but an agent that can run script in that page can read what was typed there.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは、保存済みのログインを最前面のブラウザタブに入力するよう kagisecure に求めることができ、各入力は Touch ID またはログインパスワードによるあなたの承認を待ちます。kagisecure がエージェントに値を渡すことはありませんが、そのページでスクリプトを実行できるエージェントは入力された内容を読み取れます。"
          }
        }
      }
    },
    "An environment is a named set of variables agents this Mac shares with can ask to have written into a project.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境は名前付きの変数セットです。この Mac が共有しているエージェントは、それをプロジェクトに書き込むよう求めることができます。"
          }
        }
      }
    },
    "An environment is a named set of variables an agent can ask to have written into a project. Create one, or let an agent create it for you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境とは、エージェントがプロジェクトへの書き込みを求めることができる、名前付きの変数のセットです。自分で作成するか、エージェントに作成させてください。"
          }
        }
      }
    },
    "An invitation for another computer of %@, with the same role.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の別のコンピュータ用の招待です。役割は同じです。"
          }
        }
      }
    },
    "Another confirmation is already in progress. Finish or cancel it first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の確認がすでに進行中です。先に完了するかキャンセルしてください。"
          }
        }
      }
    },
    "Another confirmation is already on screen. Finish or cancel it, then try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の確認がすでに表示されています。完了するかキャンセルしてから、もう一度お試しください。"
          }
        }
      }
    },
    "Another confirmation is in progress": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の確認が進行中です"
          }
        }
      }
    },
    "Another confirmation is in progress.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の確認が進行中です。"
          }
        }
      }
    },
    "Another kagisecure process is using the vault right now. Try again in a moment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の kagisecure プロセスが保管庫を使用中です。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "App Group": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Group"
          }
        }
      }
    },
    "Applies to every copy — passwords, one-time codes, anything the app puts on the clipboard. Only kagisecure's own copy is removed: if you copied something else in the meantime, that is left alone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード、ワンタイムコードなど、アプリがクリップボードに置くすべてのコピーに適用されます。消去されるのは kagisecure がコピーしたものだけで、その間に別のものをコピーした場合はそのまま残ります。"
          }
        }
      }
    },
    "Archive": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ"
          }
        }
      }
    },
    "Archived": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済み"
          }
        }
      }
    },
    "Arguments, one per line": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引数（1行に1つ）"
          }
        }
      }
    },
    "Arm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効化"
          }
        }
      }
    },
    "Arm unattended jobs?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無人ジョブを有効化しますか？"
          }
        }
      }
    },
    "Armed since %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から有効"
          }
        }
      }
    },
    "Armed, but the key could not be kept in the Keychain, so a restart will pause jobs: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効化しましたが、鍵をキーチェーンに保存できなかったため、再起動するとジョブは一時停止します: %@"
          }
        }
      }
    },
    "Arm…": {
      "localizations": {
