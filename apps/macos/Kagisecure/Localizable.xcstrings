        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値"
          }
        }
      }
    },
    "Values stay in the vault. Nothing here is ever returned to an agent.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値は保管庫内に留まります。ここにあるものがエージェントに返されることはありません。"
