    "Sync Now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ同期"
          }
        }
      }
    },
    "Synced %@. Changes sync by themselves while kagisecure is open.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に同期しました。kagisecure が開いている間、変更は自動的に同期されます。"
