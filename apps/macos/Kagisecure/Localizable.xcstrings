          "stringUnit": {
            "state": "translated",
            "value": "操作"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "Add a Login…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインを追加…"
          }
        }
      }
    },
    "Add a one-time password": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタイムパスワードを追加"
          }
        }
      }
    },
    "Add a shared vault": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有保管庫を追加"
          }
        }
      }
    },
    "Add a variable": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変数を追加"
          }
        }
      }
    },
    "Add an Environment…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境を追加…"
          }
        }
      }
    },
    "Add an environment or a login below, then create a job that uses it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下で環境またはログイン情報を追加してから、それを使用するジョブを作成してください。"
          }
        }
      }
    },
    "Add field": {
