<Page
    x:Class="Kagisecure.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kagisecure.App.ViewModels"
    xmlns:interop="using:Kagisecure.Interop"
    xmlns:converters="using:Kagisecure.App.Converters"
    xmlns:views="using:Kagisecure.App.Views">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
        <converters:ObjectToVisibilityConverter x:Key="InverseObjectToVisibilityConverter" Invert="True" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <DataTemplate x:Key="SidebarNodeTemplate" x:DataType="vm:SidebarNodeViewModel">
            <Grid Padding="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="14" />
                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind Count, Mode=OneWay}"
                    Opacity="0.6"
                    FontSize="12"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemRowTemplate" x:DataType="interop:Item">
            <Grid Padding="4,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind Subtitle}"
                        Opacity="0.6"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind Subtitle, Converter={StaticResource ObjectToVisibilityConverter}}" />
                </StackPanel>
                <FontIcon
                    Grid.Column="1"
                    Glyph="&#xE735;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Favorite, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar: ui-spec.md §2.3 -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <AppBarButton Icon="Add" Label="New item">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="NewItemMenu" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.RefreshCountsCommand}" />
            <AppBarSeparator />
            <AppBarButton x:Name="GeneratePasswordButton" Label="Generate password" Click="OnGeneratePasswordClicked">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE192;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Import…" Click="OnImportClicked">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8B5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Audit log" Click="OnAuditClicked">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Settings" Click="OnSettingsClicked">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Lock now (Ctrl+L)" Command="{x:Bind ViewModel.LockNowCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" ColumnDefinitions="260,360,*">

            <!-- Sidebar: ui-spec.md §2.2 -->
            <ScrollViewer Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Padding="8" Spacing="4">
                    <ListView
                        x:Name="TopList"
                        ItemsSource="{x:Bind ViewModel.TopNodes}"
                        ItemTemplate="{StaticResource SidebarNodeTemplate}"
                        SelectionMode="Single"
                        SelectionChanged="OnTopListSelectionChanged" />

                    <TextBlock Text="CATEGORIES" Opacity="0.5" FontSize="11" Margin="8,12,0,4" />
                    <ListView
                        x:Name="CategoryList"
                        ItemsSource="{x:Bind ViewModel.CategoryNodes}"
                        ItemTemplate="{StaticResource SidebarNodeTemplate}"
                        SelectionMode="Single"
                        SelectionChanged="OnCategoryListSelectionChanged" />

                    <TextBlock Text="TAGS" Opacity="0.5" FontSize="11" Margin="8,12,0,4"
                               Visibility="{x:Bind ViewModel.TagNodes.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />
                    <ListView
                        x:Name="TagList"
                        ItemsSource="{x:Bind ViewModel.TagNodes}"
                        ItemTemplate="{StaticResource SidebarNodeTemplate}"
                        SelectionMode="Single"
                        SelectionChanged="OnTagListSelectionChanged" />

                    <!-- ui-spec.md §2.2 / §10.4: Agent access. Pages open over the list and detail panes; see ShellPage.AgentAccess.cs. -->
                    <TextBlock Text="AGENT ACCESS" Opacity="0.5" FontSize="11" Margin="8,12,0,4" />
                    <ListView
                        x:Name="AgentAccessList"
                        ItemsSource="{x:Bind AgentAccessNodes}"
                        SelectionMode="Single"
                        SelectionChanged="OnAgentAccessSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:AgentAccessNode">
                                <Grid Padding="4" ColumnSpacing="8" ColumnDefinitions="Auto,*">
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView
                        x:Name="BottomList"
                        ItemsSource="{x:Bind ViewModel.BottomNodes}"
                        ItemTemplate="{StaticResource SidebarNodeTemplate}"
                        SelectionMode="Single"
                        SelectionChanged="OnBottomListSelectionChanged"
                        Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Item list pane: ui-spec.md §3 -->
            <Grid Grid.Column="1" BorderThickness="1,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" RowDefinitions="Auto,Auto,*">
                <TextBox
                    Grid.Row="0"
                    Margin="8"
                    PlaceholderText="Search"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="1" Margin="8,0,8,4" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ItemListHeader, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{x:Bind ViewModel.SortOptions}"
                        SelectedItem="{x:Bind ViewModel.SortOrder, Mode=TwoWay}" />
                </Grid>

                <ListView
                    Grid.Row="2"
                    x:Name="ItemsList"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    ItemTemplate="{StaticResource ItemRowTemplate}"
                    SelectionMode="Single"
                    SelectionChanged="OnItemsListSelectionChanged" />
            </Grid>

            <!-- Item detail pane: ui-spec.md §4 -->
            <Grid Grid.Column="2">
                <StackPanel
                    Padding="24"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource InverseObjectToVisibilityConverter}}">
                    <TextBlock Text="No item selected" Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.6" />
                </StackPanel>

                <!-- Read-only view: ui-spec.md §4.1/§4.2 -->
                <ScrollViewer
                    Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid>
                    <StackPanel Padding="24" Spacing="10" Visibility="{x:Bind ViewModel.IsEditingItem, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.CategoryDisplayName, Mode=OneWay}" Opacity="0.6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                <Button
                                    Content="&#xE734;"
                                    FontFamily="Segoe Fluent Icons"
                                    ToolTipService.ToolTip="Favorite"
                                    AutomationProperties.Name="Favorite"
                                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}" />
                                <Button Content="Edit" Command="{x:Bind ViewModel.BeginEditCommand}" />
                                <Button
                                    Content="&#xE712;"
                                    FontFamily="Segoe Fluent Icons"
                                    ToolTipService.ToolTip="More"
                                    AutomationProperties.Name="More">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Move to Archive" Command="{x:Bind ViewModel.ToggleArchivedCommand}" />
                                            <MenuFlyoutItem Text="Move to Trash / Restore" Command="{x:Bind ViewModel.ToggleTrashedCommand}" />
                                            <MenuFlyoutItem Text="Delete forever" Command="{x:Bind ViewModel.DeleteForeverCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <InfoBar IsOpen="{x:Bind ViewModel.SelectedItem.Archived, Mode=OneWay}" Severity="Informational" Message="Archived" IsClosable="False" Padding="0" />
                            <InfoBar IsOpen="{x:Bind ViewModel.SelectedItem.Trashed, Mode=OneWay}" Severity="Warning" Message="In Trash" IsClosable="False" Padding="0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedItem.Tags, Mode=OneWay}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                        <!-- Fields, grouped into sections (ui-spec.md §4.2), matching macOS's ItemDetailView: every field sharing a section name is one group, wherever in the list it falls (see ShellViewModel.Sections.cs's GroupBySection). -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DetailSections, Mode=OneWay}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetailSectionViewModel">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Opacity="0.5"
                                            Margin="0,6,0,2"
                                            Visibility="{x:Bind Name, Converter={StaticResource StringToVisibilityConverter}}"
                                            AutomationProperties.Name="{x:Bind Name}" />
                                        <ItemsControl ItemsSource="{x:Bind Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FieldRowViewModel">
                                                    <StackPanel Margin="0,4,0,4">
                                                        <Grid ColumnDefinitions="120,*,Auto,Auto">
                                                            <TextBlock Grid.Column="0" Text="{x:Bind Field.Label}" Opacity="0.6" VerticalAlignment="Center" />

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{x:Bind DisplayValue, Mode=OneWay}"
                                                                VerticalAlignment="Center"
                                                                TextWrapping="Wrap"
                                                                Visibility="{x:Bind IsTotp, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                Visibility="{x:Bind IsTotp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <ProgressRing IsIndeterminate="False" Value="{x:Bind TotpFraction, Mode=OneWay}" Minimum="0" Maximum="1" Width="22" Height="22" />
                                                                <TextBlock Text="{x:Bind TotpGrouped, Mode=OneWay}" FontFamily="Consolas" FontSize="18" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind TotpSecondsText, Mode=OneWay}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind TotpError, Mode=OneWay}" Foreground="Red" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <Button
                                                                Grid.Column="2"
                                                                Content="Reveal"
                                                                FontSize="11"
                                                                Visibility="{x:Bind ShowRevealButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                IsEnabled="{x:Bind CanReveal, Mode=OneWay}"
                                                                Command="{x:Bind RevealCommand}" />
                                                            <Button
                                                                Grid.Column="2"
                                                                Content="Show code"
                                                                FontSize="11"
                                                                Visibility="{x:Bind ShowTotpButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Command="{x:Bind ShowTotpCommand}" />

                                                            <Button
                                                                Grid.Column="3"
                                                                Content="Copy"
                                                                FontSize="11"
                                                                Visibility="{x:Bind ShowCopyButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Command="{x:Bind CopyCommand}" />
                                                            <Button
                                                                Grid.Column="3"
                                                                Content="Copy"
                                                                FontSize="11"
                                                                Visibility="{x:Bind IsTotp, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Command="{x:Bind CopyTotpCommand}" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind CopiedNotice, Mode=OneWay}" Opacity="0.6" FontSize="11" Margin="120,0,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Notes are secret (ADR-0038 user decision 3): masked until "Show notes" and a Windows Hello confirmation. -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,12,0,0"
                            Visibility="{x:Bind ViewModel.NotesText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.NotesText, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="480" />
                            <Button
                                Content="Show notes"
                                FontSize="11"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind ViewModel.CanShowNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{x:Bind ViewModel.ShowNotesCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Edit mode: ui-spec.md §4.3 -->
                    <StackPanel Padding="24" Spacing="12" Visibility="{x:Bind ViewModel.IsEditingItem, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Edit item" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <TextBlock Text="Title" Opacity="0.6" />
                        <TextBox Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Sections (ui-spec.md §4.3: "sections can be added/renamed/reordered/removed"). EditSections is a grouped view of EditFields, kept in sync by ShellViewModel.Sections.cs; moving a field between sections is its own Section box below, which that same file watches. -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EditSections, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EditSectionViewModel">
                                    <StackPanel Margin="0,6,0,6" Spacing="4">
                                        <Grid
                                            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                                            ColumnSpacing="4"
                                            Visibility="{x:Bind CanManage, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBox
                                                Grid.Column="0"
                                                Text="{x:Bind RenameText, Mode=TwoWay}"
                                                Width="160"
                                                FontWeight="SemiBold"
                                                AutomationProperties.Name="Section name" />
                                            <Button
                                                Grid.Column="1"
                                                Content="Rename"
                                                Command="{x:Bind RenameCommand}"
                                                AutomationProperties.Name="Rename section" />
                                            <Button
                                                Grid.Column="2"
                                                Content="&#xE74B;"
                                                FontFamily="Segoe Fluent Icons"
                                                ToolTipService.ToolTip="Move section up"
                                                AutomationProperties.Name="Move section up"
                                                Command="{x:Bind MoveUpCommand}" />
                                            <Button
                                                Grid.Column="3"
                                                Content="&#xE74A;"
                                                FontFamily="Segoe Fluent Icons"
                                                ToolTipService.ToolTip="Move section down"
                                                AutomationProperties.Name="Move section down"
                                                Command="{x:Bind MoveDownCommand}" />
                                            <Button
                                                Grid.Column="4"
                                                Content="Delete section"
                                                ToolTipService.ToolTip="Fields move to &quot;no section&quot;, they are not deleted"
                                                Command="{x:Bind DeleteCommand}"
                                                AutomationProperties.Name="Delete section" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{x:Bind Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FieldDraftRowViewModel">
                                                    <Grid Margin="0,4,0,4" ColumnDefinitions="140,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                                                        <TextBox Grid.Column="0" Text="{x:Bind Label, Mode=TwoWay}" PlaceholderText="Label" />

                                                        <TextBox
                                                            Grid.Column="1"
                                                            Text="{x:Bind Value, Mode=TwoWay}"
                                                            PlaceholderText="{x:Bind ValuePlaceholder, Mode=OneWay}"
                                                            Visibility="{x:Bind IsTotp, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Content="{x:Bind TotpSetupLabel, Mode=OneWay}"
                                                            HorizontalAlignment="Stretch"
                                                            Tag="{x:Bind}"
                                                            Click="OnTotpSetupClicked"
                                                            Visibility="{x:Bind IsTotp, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            AutomationProperties.Name="{x:Bind TotpSetupLabel, Mode=OneWay}" />

                                                        <TextBox
                                                            Grid.Column="2"
                                                            Text="{x:Bind Section, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="Section"
                                                            Width="110"
                                                            AutomationProperties.Name="Section" />
                                                        <CheckBox
                                                            Grid.Column="3"
                                                            Content="Concealed"
                                                            IsChecked="{x:Bind Concealed, Mode=TwoWay}"
                                                            Visibility="{x:Bind IsTotp, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                        <Button
                                                            Grid.Column="4"
                                                            Content="&#xE74B;"
                                                            FontFamily="Segoe Fluent Icons"
                                                            ToolTipService.ToolTip="Move up"
                                                            AutomationProperties.Name="Move up"
                                                            Tag="{x:Bind}"
                                                            Click="OnMoveFieldUpClicked" />
                                                        <Button
                                                            Grid.Column="5"
                                                            Content="&#xE74A;"
                                                            FontFamily="Segoe Fluent Icons"
                                                            ToolTipService.ToolTip="Move down"
                                                            AutomationProperties.Name="Move down"
                                                            Tag="{x:Bind}"
                                                            Click="OnMoveFieldDownClicked" />
                                                        <Button
                                                            Grid.Column="6"
                                                            Content="&#xE711;"
                                                            FontFamily="Segoe Fluent Icons"
                                                            ToolTipService.ToolTip="Remove"
                                                            AutomationProperties.Name="Remove"
                                                            Tag="{x:Bind}"
                                                            Click="OnRemoveFieldClicked" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="+ Add field">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="AddFieldMenu" />
                                </Button.Flyout>
                            </Button>
                            <TextBox
                                Text="{x:Bind ViewModel.NewSectionName, Mode=TwoWay}"
                                PlaceholderText="New section name"
                                Width="160"
                                AutomationProperties.Name="New section name" />
                            <Button
                                Content="+ Add section"
                                Command="{x:Bind ViewModel.AddSectionCommand}"
                                AutomationProperties.Name="Add section" />
                        </StackPanel>

                        <TextBlock Text="Tags (comma separated)" Opacity="0.6" Margin="0,8,0,0" />
                        <TextBox Text="{x:Bind ViewModel.EditTagsText, Mode=TwoWay}" />

                        <TextBlock Text="Websites (one per line)" Opacity="0.6" />
                        <TextBox Text="{x:Bind ViewModel.EditUrlsText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

                        <TextBlock Text="Notes" Opacity="0.6" />
                        <TextBox
                            Text="{x:Bind ViewModel.EditNotes, Mode=TwoWay}"
                            PlaceholderText="{x:Bind ViewModel.EditNotesPlaceholder, Mode=OneWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Height="80" />

                        <InfoBar IsOpen="{x:Bind ViewModel.EditError, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.EditError, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelEditCommand}" />
                            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveEditCommand}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsSavingEdit, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Agent access pages (Environments, Leases, setup, Security), over the list + detail panes. -->
            <Frame
                x:Name="AgentAccessFrame"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        </Grid>
    </Grid>
</Page>
