<Page
    x:Class="Kagisecure.App.Views.LockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Kagisecure.App.Converters">

    <Page.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <StackPanel
            MaxWidth="360"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">

            <FontIcon Glyph="&#xE72E;" FontSize="40" HorizontalAlignment="Center" Opacity="0.6" />
            <TextBlock Text="kagisecure is locked" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.VaultPath, Mode=OneWay}"
                Opacity="0.6"
                FontSize="12"
                HorizontalAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <PasswordBox
                Password="{x:Bind ViewModel.MasterPassword, Mode=TwoWay}"
                PlaceholderText="Master password"
                Margin="0,12,0,0" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Button
                Content="Unlock"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.UnlockCommand}" />

            <!-- Windows Hello (ADR-0004, ADR-0033): offered when this vault has a Windows Hello slot. -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowHelloButton, Mode=OneWay}">
                <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.UnlockWithHelloCommand}"
                        AutomationProperties.AutomationId="ks.lock.windowsHello">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEB68;" FontSize="16" />
                        <TextBlock Text="Unlock with Windows Hello" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind ViewModel.HelloNote, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HelloNote, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"
                           AutomationProperties.AutomationId="ks.lock.windowsHelloUnavailable" />
                <TextBlock Text="{x:Bind ViewModel.HelloScopeNotice}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" />

            <HyperlinkButton
                Content="Use recovery code instead"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Command="{x:Bind ViewModel.ToggleRecoveryCodeCommand}" />

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowRecoveryCode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBox
                    Text="{x:Bind ViewModel.RecoveryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="XXXX-XXXX-…"
                    FontFamily="Consolas"
                    AcceptsReturn="True"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="After unlocking this way you will be asked to set a new master password."
                    TextWrapping="Wrap"
                    Opacity="0.6"
                    FontSize="12" />
                <Button
                    Content="Unlock with recovery code"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.UnlockWithRecoveryCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
