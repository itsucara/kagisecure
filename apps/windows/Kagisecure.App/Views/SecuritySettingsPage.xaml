<Page
    x:Class="Kagisecure.App.Views.SecuritySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Kagisecure.App.Converters">

    <Page.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Windows Hello" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="10" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ToggleSwitch x:Name="HelloSwitch" Header="Unlock this vault with Windows Hello"
                              IsOn="{x:Bind ViewModel.IsHelloEnabled, Mode=OneWay}"
                              IsEnabled="{x:Bind SwitchEnabled(ViewModel.IsHelloAvailable, ViewModel.IsBusy, ViewModel.IsHelloEnabled), Mode=OneWay}"
                              Toggled="OnHelloToggled"
                              AutomationProperties.AutomationId="ks.settings.helloToggle" />
                <TextBlock Text="{x:Bind ViewModel.AvailabilityText, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ks.settings.helloAvailability" />
                <TextBlock Text="{x:Bind ViewModel.SlotDescription, Mode=OneWay}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ks.settings.helloSlot" />
                <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                           Text="Your vault key is wrapped under a key derived from a Windows Hello signature (a key the TPM attests it holds) and a secret kagisecure keeps in your Windows profile, protected with DPAPI. Turning this on asks for Windows Hello twice: once to create the key, once to use it. Unlocking never prompts by itself — only when you click. Your master password always keeps working." />

                <!-- W-1 and ADR-0033 §5, stated plainly -->
                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="This lowers the vault's protection on this PC"
                         Message="{x:Bind ViewModel.ScopeNotice}" AutomationProperties.AutomationId="ks.settings.helloScope" />

                <InfoBar IsOpen="{x:Bind ViewModel.OtherSlotWarning, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                         IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.OtherSlotWarning, Mode=OneWay}" />

                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.NeedsReEnroll, Mode=OneWay}">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Error"
                             Message="Windows Hello stopped unlocking this vault (its key or kagisecure's secret for it is gone). Turn it on again to re-enrol." />
                    <Button Content="Re-enrol Windows Hello" Command="{x:Bind ViewModel.ReEnrollCommand}" />
                </StackPanel>

                <InfoBar IsOpen="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                         IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                         AutomationProperties.AutomationId="ks.settings.helloMessage" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Text="Agents and the browser extension" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Spacing="6" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock Text="{x:Bind ViewModel.AgentListenerText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind ViewModel.ExtensionListenerText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                           Text="Both run whenever the vault is unlocked and stop the moment it locks, exactly as on macOS — there is no switch for them. What agents can reach is decided per vault and per environment under Agent access › Environments, and every injection or fill still needs your approval here, confirmed with Windows Hello (or your master password on a PC without it)." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
