<Page
    x:Class="Kagisecure.App.Views.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:interop="using:Kagisecure.Interop"
    xmlns:converters="using:Kagisecure.App.Converters">

    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,12" Spacing="8">
            <Button Content="&#xE72B; Back to items" Click="OnBackClicked" />
            <TextBlock Text="Audit" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.AutomationId="ks.audit.table" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Padding="16,0,16,10">
            <ComboBox Header="Result" SelectedIndex="0" SelectionChanged="OnOutcomeChanged" AutomationProperties.AutomationId="ks.audit.filter.outcome">
                <ComboBoxItem Content="All results" Tag="all" />
                <ComboBoxItem Content="Allowed" Tag="allowed" />
                <ComboBoxItem Content="Denied" Tag="denied" />
                <ComboBoxItem Content="Failed" Tag="failed" />
            </ComboBox>
            <ComboBox Header="Caller" SelectedIndex="0" SelectionChanged="OnActorChanged" AutomationProperties.AutomationId="ks.audit.filter.actor">
                <ComboBoxItem Content="Everyone" Tag="all" />
                <ComboBoxItem Content="Agents (mcp)" Tag="mcp" />
                <ComboBoxItem Content="This app" Tag="app" />
                <ComboBoxItem Content="The CLI" Tag="cli" />
            </ComboBox>
            <ComboBox Header="Tool" SelectedIndex="0" SelectionChanged="OnToolChanged" AutomationProperties.AutomationId="ks.audit.filter.tool">
                <ComboBoxItem Content="All tools" Tag="all" />
                <ComboBoxItem Content="Fill credential" Tag="fill_credential" />
                <ComboBoxItem Content="One-time code" Tag="totp_code" />
                <ComboBoxItem Content="Other" Tag="other" />
            </ComboBox>
            <TextBox
                Width="240"
                PlaceholderText="Filter by tool, variable or path"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="ks.audit.query" />
            <Button Content="Reload" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.AutomationId="ks.audit.reload" />
        </StackPanel>

        <Grid Grid.Row="2" Padding="16,0">
            <TextBlock
                Text="Nothing matches the current filters."
                Opacity="0.6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.AutomationId="ks.audit.empty" />

            <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="interop:AuditRow">
                        <Grid ColumnDefinitions="150,60,180,90,*" Padding="0,4">
                            <TextBlock Grid.Column="0" Text="{x:Bind Timestamp}" FontFamily="Consolas" Opacity="0.7" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Actor}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Tool}" FontFamily="Consolas" AutomationProperties.AutomationId="ks.audit.cell.tool" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Outcome}" AutomationProperties.AutomationId="ks.audit.cell.outcome" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Detail}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="3" Padding="16,8" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.ChainStateText, Mode=OneWay}" Opacity="0.6" FontSize="12" AutomationProperties.AutomationId="ks.audit.chainState" />
            <TextBlock
                Text="{x:Bind ViewModel.SaveWarningText, Mode=OneWay}"
                Foreground="Red"
                FontSize="12"
                Visibility="{x:Bind ViewModel.SaveWarningText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                AutomationProperties.AutomationId="ks.audit.saveState" />
        </StackPanel>
    </Grid>
</Page>
