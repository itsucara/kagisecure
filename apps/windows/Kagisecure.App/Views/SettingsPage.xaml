<Page
    x:Class="Kagisecure.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Kagisecure.App.Converters">

    <Page.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,12" Spacing="8">
            <Button Content="&#xE72B; Back to items" Click="OnBackClicked" />
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="20" MaxWidth="520" HorizontalAlignment="Left">

                <StackPanel Spacing="6">
                    <TextBlock Text="Auto-lock" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="ks.settings.tab.security" />
                    <ComboBox
                        Header="Lock when idle for"
                        ItemsSource="{x:Bind ViewModel.AutoLockOptions}"
                        SelectedItem="{x:Bind ViewModel.AutoLockIdleMinutes, Mode=TwoWay}"
                        AutomationProperties.AutomationId="ks.settings.autoLockInterval" />
                    <TextBlock Text="0 minutes means never — the vault still always locks on system sleep, when the screen locks, and when you quit. Those are not settings." TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
                    <CheckBox Content="Also lock when the window is minimized" IsChecked="{x:Bind ViewModel.LockOnMinimize, Mode=TwoWay}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Clipboard" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        Header="Clear the clipboard after"
                        ItemsSource="{x:Bind ViewModel.ClipboardOptions}"
                        SelectedItem="{x:Bind ViewModel.ClipboardClearSeconds, Mode=TwoWay}"
                        AutomationProperties.AutomationId="ks.settings.clipboardInterval" />
                    <TextBlock Text="Applies to every copy — passwords, one-time codes, anything the app puts on the clipboard. Only kagisecure's own copy is removed." TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Vault" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="ks.settings.tab.vault" />
                    <TextBlock Text="{x:Bind ViewModel.VaultPath, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="ks.settings.vaultPath" />

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="Audit log: " Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AuditStateText, Mode=OneWay}" AutomationProperties.AutomationId="ks.settings.auditState" />
                    </Grid>
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.AuditSaveWarning, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                        Severity="Error"
                        Message="{x:Bind ViewModel.AuditSaveWarning, Mode=OneWay}" />
                    <Button Content="View audit log" Click="OnAuditClicked" />

                    <TextBlock Text="{x:Bind ViewModel.WordlistText, Mode=OneWay}" Opacity="0.6" FontSize="12" AutomationProperties.AutomationId="ks.settings.wordlist" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
