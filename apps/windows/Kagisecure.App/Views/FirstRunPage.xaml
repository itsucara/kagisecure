<Page
    x:Class="Kagisecure.App.Views.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Kagisecure.App.Converters">

    <Page.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </Page.Resources>

    <Grid>
        <StackPanel
            MaxWidth="420"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">

            <TextBlock Text="Create your vault" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="This creates the file that holds every item. Choose where it lives and a master password to unlock it."
                TextWrapping="Wrap"
                Opacity="0.7" />

            <TextBlock Text="Vault name" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBox Text="{x:Bind ViewModel.VaultName, Mode=TwoWay}" />

            <TextBlock Text="Location" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.VaultPath, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseClicked" />
            </Grid>

            <TextBlock Text="Master password" FontWeight="SemiBold" Margin="0,8,0,0" />
            <PasswordBox Password="{x:Bind ViewModel.MasterPassword, Mode=TwoWay}" PlaceholderText="Master password" />
            <TextBlock Text="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}" Opacity="0.7" FontSize="12" />

            <TextBlock Text="Confirm password" FontWeight="SemiBold" Margin="0,8,0,0" />
            <PasswordBox Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}" PlaceholderText="Confirm master password" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Margin="0,8,0,0" />

            <Button
                Content="Create vault"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                Margin="0,12,0,0"
                Command="{x:Bind ViewModel.CreateCommand}" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Page>
