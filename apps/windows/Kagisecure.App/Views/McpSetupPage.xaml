<Page
    x:Class="Kagisecure.App.Views.McpSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kagisecure.App.ViewModels"
    xmlns:converters="using:Kagisecure.App.Converters">

    <Page.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock Text="Let an agent ask" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="ks.agentSetup.title" />
                <TextBlock Text="{x:Bind Intro}" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />

            <!-- The server binary -->
            <StackPanel Spacing="8" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock Text="The server binary" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="{x:Bind ViewModel.SidecarPath, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ViewModel.SidecarPath, Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               VerticalAlignment="Center" AutomationProperties.AutomationId="ks.agentSetup.sidecarPath" />
                    <Button Grid.Column="1" Content="Copy" Command="{x:Bind ViewModel.CopySidecarCommand}" AutomationProperties.AutomationId="ks.agentSetup.copy.sidecar" />
                </Grid>
                <InfoBar IsOpen="{x:Bind ViewModel.SidecarMissing, Mode=OneWay}" IsClosable="False" Severity="Warning"
                         Message="{x:Bind SidecarMissingText}" AutomationProperties.AutomationId="ks.agentSetup.sidecarMissing" />
                <TextBlock Text="{x:Bind ViewModel.ListenerText, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>

            <!-- One snippet per client -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Snippets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:McpSnippetRowViewModel">
                        <StackPanel Spacing="8" Margin="0,0,0,20">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="8" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Language}" FontSize="11" />
                                </Border>
                                <Button Grid.Column="3" Content="Copy" Command="{x:Bind CopyCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind WhereText}" FontSize="12" Opacity="0.7" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Body}" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{x:Bind Footer}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" AutomationProperties.AutomationId="ks.agentSetup.footer" />
        </StackPanel>
    </ScrollViewer>
</Page>
