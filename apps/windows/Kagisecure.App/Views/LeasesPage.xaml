<Page
    x:Class="Kagisecure.App.Views.LeasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kagisecure.App.ViewModels">

    <Grid RowDefinitions="Auto,*" Padding="24,16,24,16" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Leases" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" Content="Revoke all" Command="{x:Bind ViewModel.RevokeAllCommand}"
                    ToolTipService.ToolTip="Drop every lease, shred every file they wrote, and make the next browser fill ask again"
                    AutomationProperties.AutomationId="ks.leases.revokeAll" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" AutomationProperties.AutomationId="ks.leases.empty">
                    <TextBlock Text="No active leases" Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind EmptyMessage}" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>

                <!-- Env / run leases -->
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasLeases, Mode=OneWay}">
                    <TextBlock Text="Agents" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="2*,3*,3*,110,70,80" Opacity="0.6" Padding="8,0">
                        <TextBlock Grid.Column="0" Text="Caller" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="Directory" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Variables" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="Expires in" FontSize="12" />
                        <TextBlock Grid.Column="4" Text="Uses left" FontSize="12" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Leases}" AutomationProperties.AutomationId="ks.leases.table">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LeaseRowViewModel">
                                <Grid ColumnDefinitions="2*,3*,3*,110,70,80" Padding="8,6" ColumnSpacing="8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Margin="0,2">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Caller}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Caller}" />
                                        <TextBlock Text="{x:Bind KindText}" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Directory}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Directory}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Variables}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Variables}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Remaining, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind UsesLeft}" VerticalAlignment="Center" />
                                    <Button Grid.Column="5" Content="Revoke" Command="{x:Bind RevokeCommand}" AutomationProperties.AutomationId="ks.leases.revoke" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Browser fills (M6): a different thing, so a separate table -->
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasFillLeases, Mode=OneWay}">
                    <TextBlock Text="Browser fills" FontWeight="SemiBold" AutomationProperties.AutomationId="ks.fillLeases.heading" />
                    <Grid ColumnDefinitions="3*,2*,2*,110,80" Opacity="0.6" Padding="8,0">
                        <TextBlock Grid.Column="0" Text="Website" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="Item" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Browser" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="Expires in" FontSize="12" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FillLeases}" AutomationProperties.AutomationId="ks.fillLeases.table">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FillLeaseRowViewModel">
                                <Grid ColumnDefinitions="3*,2*,2*,110,80" Padding="8,6" ColumnSpacing="8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{x:Bind Website}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Website}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Item}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Browser}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Browser}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Remaining, Mode=OneWay}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Content="Revoke" Command="{x:Bind RevokeCommand}" AutomationProperties.AutomationId="ks.fillLeases.revoke" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
